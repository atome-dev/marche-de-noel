#--------------------------------------------------------------------------
# Application
#--------------------------------------------------------------------------
APP_NAME="Marché de Noël"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#--------------------------------------------------------------------------
# Base de données (MySQL / MariaDB)
#--------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marche_noel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

#--------------------------------------------------------------------------
# Courriels (Mailjet, via SMTP)
# MAIL_USERNAME = clé API Mailjet, MAIL_PASSWORD = clé secrète Mailjet.
# L'adresse d'expédition doit être validée dans le compte Mailjet.
#--------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=in-v3.mailjet.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="marche-noel@example.org"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# Marché de Noël — paramètres annuels (à redéfinir chaque année)
#--------------------------------------------------------------------------
MARCHE_NAME="Marché de Noël 2026"
MARCHE_SCHOOL_NAME="École Steiner Waldorf de Verrières-le-Buisson"
MARCHE_SCHOOL_URL=https://ecole-steiner-verrieres.org/

# Adresse de contact affichée sur la page « Données personnelles ».
MARCHE_PRIVACY_CONTACT_EMAIL=accueil@ecole-steiner-verrieres.org

# Mot de passe commun communiqué aux familles pour demander la création d'un compte.
MARCHE_TEMP_PASSWORD=

# Validité (en minutes) du lien de création de compte envoyé par courriel.
MARCHE_REGISTRATION_LINK_TTL=1440

# Validité (en minutes) du lien d'invitation envoyé par un administrateur (10080 = 7 jours).
MARCHE_INVITATION_LINK_TTL=10080

# Dates du marché (AAAA-MM-JJ), séparées par des virgules.
MARCHE_DATES=2026-11-28,2026-11-29

# Langues activées dans le profil (prévues : fr,en,de,es,pt,it).
MARCHE_LOCALES=fr

# Plage horaire du planning (HH:MM).
PLANNING_HOUR_MIN=09:00
PLANNING_HOUR_MAX=20:00

# Durées possibles d'un créneau, en minutes (0:30, 1:00, 1:30 et 2:00).
PLANNING_SLOT_DURATIONS=30,60,90,120

# Créneaux créés par défaut pour chaque nouveau stand, chaque jour du marché.
PLANNING_DEFAULT_SLOTS=12:30-14:00,14:30-16:00,16:00-17:30,17:30-19:00,19:00-20:00
PLANNING_DEFAULT_CAPACITY=2

# Date butoir des commandes d'ingrédients (AAAA-MM-JJ HH:MM).
ORDER_DEADLINE="2026-11-15 23:59"

# Ingrédients commandables, séparés par des virgules.
ORDER_INGREDIENTS="Poudre d'amande,Poudre de noisette,Noix de coco râpée"

# Quantités proposées pour « Je prévois de réaliser », en kilos.
ORDER_QUANTITIES=1,2,3

# Taille maximale (en Mo) d'un document téléversé par l'administrateur.
# Le serveur doit l'autoriser aussi : upload_max_filesize et post_max_size (PHP),
# client_max_body_size (Nginx).
DOCUMENTS_MAX_SIZE_MB=20

# Fuseau horaire d'affichage des dates des instantanés.
MARCHE_TIMEZONE=Europe/Paris

# Instantanés des données, pris toutes les 15 minutes par le planificateur :
# nombre de jours de conservation (les plus anciens sont effacés).
SNAPSHOT_RETENTION_DAYS=30

# Adresse « heartbeat » (Forge) appelée après chaque instantané réussi : Forge
# alerte si elle n'est plus appelée. Laisser vide pour ne pas surveiller.
SNAPSHOT_HEARTBEAT_URL=

# Clé API YouTube / Google (facultative).
YOUTUBE_API_KEY=

#--------------------------------------------------------------------------
# Développement uniquement
# Compte administrateur créé par « php artisan migrate:fresh --seed ».
# Laisser vide pour ne pas le créer. Ne jamais lancer ce seeder en production.
#--------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
